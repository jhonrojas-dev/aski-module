<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Marca Aski: el ICONO REAL de la app, compuesto igual que el adaptive-icon
         de Android (bg #152642 + foreground con inset 16%, recorte 72/108). Se
         enmascara con squircle (border-radius 26%) en el SCSS, NO con circulo.
         OJO: el ?v= es OBLIGATORIO — Odoo/el service worker cachean los estaticos
         por URL, asi que cambiar el PNG sin cambiar la URL NO se ve (ni con
         Ctrl+Shift+R). Si se vuelve a tocar el PNG, SUBIR el numero. -->
    <t t-name="aski_connector.AskiMark" owl="1">
        <img class="ac-mark-img" src="/aski_connector/static/src/img/aski_mark.png?v=4" alt="Aski"/>
    </t>

    <t t-name="aski_connector.ChatWidget" owl="1">
        <div class="aski-chat">

            <div class="ac-header" t-att-class="props.minimized ? 'ac-header-clickable' : ''"
                 t-on-click="() => props.minimized ? props.onMinimize() : null">
                <div class="ac-header-l">
                    <button t-if="state.connected and !props.minimized" class="ac-icon-btn" title="Conversations"
                            t-on-click.stop="toggleDrawer">
                        <i class="fa fa-bars"/>
                    </button>
                    <span class="ac-mark">
                        <t t-call="aski_connector.AskiMark"/>
                        <span t-if="state.connected" class="ac-mark-dot"/>
                    </span>
                    <div class="ac-header-id">
                        <span class="ac-title">Aski</span>
                        <span t-if="!props.minimized" class="ac-subtitle">AI assistant · read-only</span>
                    </div>
                </div>
                <div class="ac-header-r">
                    <t t-if="state.connected">
                        <button t-if="state.walletCredits === 0 and !state.partnerManaged"
                                class="ac-credits ac-credits-empty"
                                title="Out of credits - tap to top up" t-on-click.stop="openBilling">
                            <i class="fa fa-exclamation-circle"/> Out of credits
                        </button>
                        <span t-if="state.walletCredits === 0 and state.partnerManaged"
                              class="ac-credits ac-credits-empty"
                              title="Out of credits - your Aski partner tops them up">
                            <i class="fa fa-exclamation-circle"/> Out of credits
                        </span>
                        <span class="ac-credits" t-else="">
                            <i class="fa fa-bolt"/> <t t-esc="state.walletCredits"/>
                        </span>
                        <span class="ac-plan" t-if="state.planName and !props.minimized" t-esc="state.planName"/>
                    </t>
                    <button t-if="props.onMinimize" class="ac-icon-btn" title="Minimize"
                            t-on-click.stop="props.onMinimize">
                        <i class="fa fa-minus"/>
                    </button>
                    <button t-if="props.onClose" class="ac-icon-btn ac-icon-btn-close" title="Close"
                            t-on-click.stop="props.onClose">
                        <i class="fa fa-times"/>
                    </button>
                </div>
            </div>

            <t t-if="!props.minimized">

            <!-- Drawer de conversaciones, estilo Discuss/ChatGPT -->
            <t t-if="state.drawerOpen">
                <div class="ac-scrim" t-on-click="toggleDrawer"/>
                <div class="ac-drawer">
                    <div class="ac-drawer-head">Conversations</div>
                    <button class="ac-drawer-new" t-on-click="newConversation">
                        <i class="fa fa-plus"/> New conversation
                    </button>
                    <div t-if="!state.conversations.length" class="ac-drawer-empty">
                        No conversations yet.
                    </div>
                    <t t-foreach="state.conversations" t-as="c" t-key="c.id">
                        <!-- Renombrando ESTE hilo -->
                        <div t-if="state.renamingId === c.id" class="ac-drawer-rename">
                            <input type="text" t-att-value="state.renameText"
                                   t-on-input="onRenameInput" t-on-keydown="onRenameKeydown"
                                   placeholder="Conversation name"/>
                            <div class="ac-confirm-actions">
                                <button class="ac-confirm-cancel" t-on-click="cancelRename">Cancel</button>
                                <button class="ac-confirm-ok" t-on-click="doRename"
                                        t-att-disabled="!state.renameText.trim()">Save</button>
                            </div>
                        </div>

                        <!-- Confirmando el borrado de ESTE hilo. In-app, nunca
                             window.confirm. Se dice "quitar de la lista" porque
                             del lado de Aski es un archivado, no un borrado. -->
                        <div t-elif="state.confirmDeleteId === c.id" class="ac-confirm ac-confirm-inline">
                            <div class="ac-confirm-txt">Remove this conversation from your list?</div>
                            <div class="ac-confirm-actions">
                                <button class="ac-confirm-cancel" t-on-click="cancelDelete">Cancel</button>
                                <button class="ac-confirm-ok" t-on-click="doDelete">Remove</button>
                            </div>
                        </div>

                        <div t-else="" t-attf-class="ac-drawer-item {{ c.id === state.conversationId ? 'active' : '' }}">
                            <span class="ac-drawer-title" t-on-click="() => this.openConversation(c.id)"
                                  t-esc="this.conversationTitle(c)"/>
                            <span class="ac-drawer-item-actions">
                                <button class="ac-icon-btn" title="Rename"
                                        t-on-click.stop="() => this.askRename(c)">
                                    <i class="fa fa-pencil"/>
                                </button>
                                <button class="ac-icon-btn" title="Remove"
                                        t-on-click.stop="() => this.askDelete(c)">
                                    <i class="fa fa-trash-o"/>
                                </button>
                            </span>
                        </div>
                    </t>

                    <!-- Cerrar sesion de la cuenta Aski. Solo a quien le
                         corresponde: en per_user cada quien la suya, en los
                         modos compartidos solo el admin (canConnect). -->
                    <div t-if="state.connected and state.canConnect" class="ac-drawer-foot">
                        <!-- CON QUE cuenta se esta hablando. En modo "por
                             usuario" cada quien conecta la suya y, sin esto, no
                             habia forma de saber cual quedo conectada aqui. -->
                        <div t-if="state.email" class="ac-drawer-account">
                            <i class="fa fa-user-circle-o"/> <t t-esc="state.email"/>
                        </div>
                        <button t-if="!state.confirmDisconnect" class="ac-drawer-disconnect"
                                t-on-click="askDisconnect">
                            <i class="fa fa-sign-out"/> Disconnect my Aski account
                        </button>
                        <div t-else="" class="ac-confirm">
                            <div class="ac-confirm-txt">Disconnect this Aski account? You can reconnect anytime with your token.</div>
                            <div class="ac-confirm-actions">
                                <button class="ac-confirm-cancel" t-on-click="cancelDisconnect">Cancel</button>
                                <button class="ac-confirm-ok" t-on-click="doDisconnect"
                                        t-att-disabled="state.disconnecting">
                                    <i t-if="state.disconnecting" class="fa fa-circle-o-notch fa-spin"/>
                                    Disconnect
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </t>

            <!-- loading-state -->
            <div t-if="state.loading" class="ac-loading">
                <i class="fa fa-circle-o-notch fa-spin"/> <span>Loading…</span>
            </div>

            <!-- error-state: el estado NO se pudo leer (backend caido, sin red,
                 RPC roto). Va ANTES que "no conectado" a proposito: son cosas
                 distintas y antes se pintaban igual, asi que a quien ya tenia su
                 cuenta conectada se le pedia conectarla otra vez. -->
            <div t-elif="state.loadError" class="ac-empty">
                <span class="ac-mark ac-mark--lg"><t t-call="aski_connector.AskiMark"/></span>
                <div class="ac-empty-title">Aski isn't responding right now</div>
                <div class="ac-empty-sub" t-esc="state.loadError"/>
                <button class="ac-btn-primary" t-on-click="retryLoad">
                    <i class="fa fa-refresh"/> Try again
                </button>
            </div>

            <!-- empty-state: usuario fuera del grupo "Use the Aski chat" -->
            <div t-elif="!state.allowed" class="ac-empty">
                <span class="ac-mark ac-mark--lg"><t t-call="aski_connector.AskiMark"/></span>
                <div class="ac-empty-title">Aski chat isn't enabled for your user</div>
                <div class="ac-empty-sub">Ask an administrator to add you to the "Use the Aski chat" group to start asking your Odoo in plain language.</div>
            </div>

            <!-- empty-state: cuenta Aski no conectada -->
            <div t-elif="!state.connected" class="ac-empty">
                <span class="ac-mark ac-mark--lg"><t t-call="aski_connector.AskiMark"/></span>
                <t t-if="state.canConnect">
                    <div class="ac-empty-title">Connect Aski to start chatting</div>
                    <div class="ac-empty-sub">
                        Ask your Odoo in plain language, right here — sales, receivables,
                        top products and more.
                    </div>
                    <button class="ac-btn-primary" t-on-click="openConnect">
                        Connect my Aski account
                    </button>
                </t>
                <t t-else="">
                    <div class="ac-empty-title">Aski isn't set up yet</div>
                    <div class="ac-empty-sub">
                        Ask an administrator to connect Aski for your team.
                    </div>
                </t>
            </div>

            <t t-else="">
                <div class="ac-messages" t-ref="messages">
                    <!-- welcome hero (nueva conversacion, sin mensajes) -->
                    <div t-if="!state.messages.length" class="ac-welcome">
                        <span class="ac-mark ac-mark--lg"><t t-call="aski_connector.AskiMark"/></span>
                        <div class="ac-welcome-title">Hi, I'm Aski</div>
                        <div class="ac-welcome-sub">Ask about your business in plain language — sales, receivables, top customers and more. Read-only &amp; safe.</div>
                        <!-- Las sugerencias vienen del getter `samples` (JS, con _t()):
                             la etiqueta y el texto que se ENVIA son el MISMO string
                             traducido. Antes el t-on-click llevaba el literal ingles
                             hardcodeado -> se veia en espanol pero se mandaba en ingles. -->
                        <div class="ac-samples">
                            <button t-foreach="samples" t-as="s" t-key="s.text"
                                    class="ac-sample" t-on-click="() => this.useSample(s.text)">
                                <i t-attf-class="fa {{ s.icon }}"/> <t t-esc="s.text"/>
                            </button>
                        </div>
                    </div>
                    <t t-foreach="state.messages" t-as="m" t-key="m.id">
                        <div t-if="m.role === 'user'" class="ac-bubble ac-bubble-user">
                            <span t-esc="m.text"/>
                            <!-- Esta pregunta se hizo en analisis profundo. Va en
                                 la PREGUNTA y no en la respuesta porque es ahi
                                 donde lo guarda el backend (is_agent) y donde lo
                                 pintan la app y la web: al recargar el hilo, el
                                 distintivo sigue en su sitio. -->
                            <span t-if="m.deep" class="ac-deep-chip">
                                <i class="fa fa-flask"/> Deep
                            </span>
                        </div>
                        <div t-elif="m.role === 'assistant'" class="ac-bubble ac-bubble-bot">
                            <div class="md" t-out="renderMd(m.text)"/>
                            <div t-if="m.credits !== null" class="ac-meta">
                                <!-- Que esta respuesta salio del analisis profundo:
                                     cuesta mas creditos y conviene que se vea. -->
                                <span t-if="m.deep" class="ac-deep-chip"><i class="fa fa-flask"/> Deep</span>
                                <span class="ac-credits-chip"><i class="fa fa-bolt"/> <t t-esc="m.credits"/> credits</span>
                                <button t-if="m.backendId" class="ac-detail-btn" title="Details"
                                        t-on-click="() => this.toggleDetail(m)">
                                    <i class="fa fa-info-circle"/>
                                </button>
                                <button t-if="m.backendId" class="ac-detail-btn" title="Export this answer to PDF"
                                        t-on-click="() => this.exportMessageDetail(m)" t-att-disabled="state.exporting">
                                    <i t-attf-class="fa {{ state.exporting ? 'fa-circle-o-notch fa-spin' : 'fa-file-pdf-o' }}"/>
                                </button>
                            </div>
                            <div t-if="state.detailFor === m.id" class="ac-detail">
                                <div class="ac-detail-stats">
                                    <div class="ac-stat">
                                        <i class="fa fa-bolt"/>
                                        <div><div class="ac-stat-v" t-esc="m.credits ?? 0"/><div class="ac-stat-k">credits</div></div>
                                    </div>
                                    <div t-if="m.rows !== null" class="ac-stat">
                                        <i class="fa fa-table"/>
                                        <div><div class="ac-stat-v" t-esc="m.rows"/><div class="ac-stat-k">rows</div></div>
                                    </div>
                                </div>
                                <div class="ac-detail-fb">
                                    <span>Helpful?</span>
                                    <button t-attf-class="ac-fb-btn {{ m.feedback === 'like' ? 'on' : '' }}"
                                            t-on-click="() => this.setFeedback(m, 'like')">
                                        <i class="fa fa-thumbs-o-up"/>
                                    </button>
                                    <button t-attf-class="ac-fb-btn {{ m.feedback === 'dislike' ? 'on-bad' : '' }}"
                                            t-on-click="() => this.setFeedback(m, 'dislike')">
                                        <i class="fa fa-thumbs-o-down"/>
                                    </button>
                                </div>
                                <button class="ac-detail-export" t-on-click="() => this.exportMessageDetail(m)"
                                        t-att-disabled="state.exporting">
                                    <i class="fa fa-file-pdf-o"/> Export this answer
                                </button>
                            </div>
                        </div>
                        <div t-else="" class="ac-bubble ac-bubble-error">
                            <!-- Mismo renderizado que la burbuja normal: los
                                 mensajes de error del backend TAMBIEN vienen en
                                 markdown, y con t-esc el usuario leia los
                                 asteriscos crudos ("**Tu ERP no respondio.**") y
                                 perdia los saltos de parrafo. -->
                            <!-- El icono va en su PROPIO nodo y el markdown en un
                                 div hermano: mdToHtml emite bloques (<p>, <ul>)
                                 y meterlos en un <span> es HTML invalido, el
                                 navegador los reubica y rompe la burbuja. -->
                            <div class="ac-error-body">
                                <i class="fa fa-exclamation-triangle"/>
                                <div class="md" t-out="renderMd(m.text)"/>
                            </div>
                            <div class="ac-error-actions">
                                <!-- Se le pasa el MENSAJE, no solo el texto: al
                                     reintentar hay que retirar esta burbuja, o
                                     los errores se van apilando en el hilo. -->
                                <button class="ac-btn-link" t-on-click="() => this.retry(m)">
                                    Retry
                                </button>
                                <button t-if="m.sinCreditos and !state.partnerManaged"
                                        class="ac-btn-link" t-on-click="openBilling">
                                    Top up credits
                                </button>
                            </div>
                        </div>
                    </t>
                    <!-- "Aski esta pensando" -->
                    <div t-if="state.sending" class="ac-bubble ac-bubble-bot ac-thinking">
                        <span class="ac-typing"><i/><i/><i/></span>
                        <!-- El tiempo REAL transcurrido (no fases inventadas: el
                             backend no reporta progreso por esta via). Aparece a
                             los 3 s para no parpadear en las respuestas rapidas;
                             en analisis profundo se avisa de que va para largo,
                             que puede pasar del minuto. -->
                        <span t-if="state.elapsed >= 3" class="ac-thinking-note">
                            <t t-if="state.sendingDeep">Digging deeper — this one takes a while.</t>
                            <t t-else="">Working on it…</t>
                            <span class="ac-thinking-secs"><t t-esc="state.elapsed"/>s</span>
                        </span>
                    </div>
                </div>

                <div class="ac-composer">
                    <!-- El agente avisa de que la consulta es pesada y espera el
                         visto bueno, igual que en la app. -->
                    <div t-if="state.pendingHeavy" class="ac-heavy">
                        <div class="ac-heavy-txt">This one needs a heavier analysis. Run it anyway?</div>
                        <div class="ac-heavy-actions">
                            <button class="ac-confirm-cancel" t-on-click="cancelHeavy">Not now</button>
                            <button class="ac-confirm-ok" t-on-click="confirmHeavy"
                                    t-att-disabled="state.sending">Run it</button>
                        </div>
                    </div>

                    <!-- Analisis profundo: solo se ofrece si el plan lo incluye
                         (agentEnabled lo dice el backend). Ofrecerlo siempre era
                         prometer algo que acaba en un 403. -->
                    <div t-if="state.agentEnabled" class="ac-composer-tools">
                        <button t-attf-class="ac-deep-toggle {{ state.deepMode ? 'on' : '' }}"
                                t-on-click="toggleDeepMode" t-att-disabled="state.sending"
                                title="Deep analysis: slower, but digs through more data">
                            <i class="fa fa-flask"/> Deep analysis
                        </button>
                    </div>

                    <div class="ac-composer-inner">
                        <button t-if="state.conversationId" class="ac-export" title="Export last answer to PDF"
                                t-on-click="exportPdf" t-att-disabled="state.exporting">
                            <i t-attf-class="fa {{ state.exporting ? 'fa-circle-o-notch fa-spin' : 'fa-file-pdf-o' }}"/>
                        </button>
                        <!-- textarea y NO input: el handler distingue Shift+Enter
                             para partir la linea, y en un <input> eso no puede
                             pasar. Sin `value` atado al estado — ver composerRef.
                             Tampoco se DESHABILITA mientras Aski responde: se
                             puede ir escribiendo la siguiente pregunta, solo el
                             boton de enviar espera. -->
                        <textarea t-ref="composer" rows="1" t-att-maxlength="MAX_PROMPT"
                                  placeholder="Ask Aski anything about your Odoo…"
                                  t-on-input="onInput" t-on-keydown="onKeydown"/>
                        <button class="ac-send" t-on-click="() => this.send()"
                                t-att-disabled="state.sending || !state.input.trim()">
                            <i t-attf-class="fa {{ state.sending ? 'fa-circle-o-notch fa-spin' : 'fa-paper-plane' }}"/>
                        </button>
                    </div>
                </div>
            </t>

            </t>
        </div>
    </t>
</templates>
