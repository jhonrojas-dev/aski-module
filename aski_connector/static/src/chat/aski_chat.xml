<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Marca Aski: el ICONO REAL de la app, compuesto igual que el adaptive-icon
         de Android (bg #152642 + foreground con inset 16%, recorte 72/108). Se
         enmascara con squircle (border-radius 26%) en el SCSS, NO con circulo.
         OJO: el ?v= es OBLIGATORIO — Odoo/el service worker cachean los estaticos
         por URL, asi que cambiar el PNG sin cambiar la URL NO se ve (ni con
         Ctrl+Shift+R). Si se vuelve a tocar el PNG, SUBIR el numero. -->
    <t t-name="aski_connector.AskiMark" owl="1">
        <img class="ac-mark-img" src="/aski_connector/static/src/img/aski_mark.png?v=4" alt="Aski"/>
    </t>

    <t t-name="aski_connector.ChatWidget" owl="1">
        <div class="aski-chat">

            <div class="ac-header" t-att-class="props.minimized ? 'ac-header-clickable' : ''"
                 t-on-click="() => props.minimized ? props.onMinimize() : null">
                <div class="ac-header-l">
                    <button t-if="state.connected and !props.minimized" class="ac-icon-btn" title="Conversations"
                            t-on-click.stop="toggleDrawer">
                        <i class="fa fa-bars"/>
                    </button>
                    <span class="ac-mark">
                        <t t-call="aski_connector.AskiMark"/>
                        <span t-if="state.connected" class="ac-mark-dot"/>
                    </span>
                    <div class="ac-header-id">
                        <span class="ac-title">Aski</span>
                        <span t-if="!props.minimized" class="ac-subtitle">AI assistant · read-only</span>
                    </div>
                </div>
                <div class="ac-header-r">
                    <t t-if="state.connected">
                        <button t-if="state.walletCredits === 0 and !state.partnerManaged"
                                class="ac-credits ac-credits-empty"
                                title="Out of credits - tap to top up" t-on-click.stop="openBilling">
                            <i class="fa fa-exclamation-circle"/> Out of credits
                        </button>
                        <span t-if="state.walletCredits === 0 and state.partnerManaged"
                              class="ac-credits ac-credits-empty"
                              title="Out of credits - your Aski partner tops them up">
                            <i class="fa fa-exclamation-circle"/> Out of credits
                        </span>
                        <span class="ac-credits" t-else="">
                            <i class="fa fa-bolt"/> <t t-esc="creditosFmt"/>
                        </span>
                        <span class="ac-plan" t-if="state.planName and !props.minimized" t-esc="state.planName"/>
                    </t>
                    <button t-if="props.onMinimize" class="ac-icon-btn" title="Minimize"
                            t-on-click.stop="props.onMinimize">
                        <i class="fa fa-minus"/>
                    </button>
                    <button t-if="props.onClose" class="ac-icon-btn ac-icon-btn-close" title="Close"
                            t-on-click.stop="props.onClose">
                        <i class="fa fa-times"/>
                    </button>
                </div>
            </div>

            <t t-if="!props.minimized">

            <!-- Drawer de conversaciones, estilo Discuss/ChatGPT -->
            <t t-if="state.drawerOpen">
                <div class="ac-scrim" t-on-click="toggleDrawer"/>
                <div class="ac-drawer">
                    <div class="ac-drawer-head">Conversations</div>
                    <button class="ac-drawer-new" t-on-click="newConversation">
                        <i class="fa fa-plus"/> New conversation
                    </button>
                    <div t-if="!state.conversations.length" class="ac-drawer-empty">
                        No conversations yet.
                    </div>
                    <t t-foreach="state.conversations" t-as="c" t-key="c.id">
                        <!-- Renombrando ESTE hilo -->
                        <div t-if="state.renamingId === c.id" class="ac-drawer-rename">
                            <input type="text" t-att-value="state.renameText"
                                   t-on-input="onRenameInput" t-on-keydown="onRenameKeydown"
                                   placeholder="Conversation name"/>
                            <div class="ac-confirm-actions">
                                <button class="ac-confirm-cancel" t-on-click="cancelRename">Cancel</button>
                                <button class="ac-confirm-ok" t-on-click="doRename"
                                        t-att-disabled="!state.renameText.trim()">Save</button>
                            </div>
                        </div>

                        <!-- Confirmando el borrado de ESTE hilo. In-app, nunca
                             window.confirm. Se dice "quitar de la lista" porque
                             del lado de Aski es un archivado, no un borrado. -->
                        <div t-elif="state.confirmDeleteId === c.id" class="ac-confirm ac-confirm-inline">
                            <div class="ac-confirm-txt">Remove this conversation from your list?</div>
                            <div class="ac-confirm-actions">
                                <button class="ac-confirm-cancel" t-on-click="cancelDelete">Cancel</button>
                                <button class="ac-confirm-ok" t-on-click="doDelete">Remove</button>
                            </div>
                        </div>

                        <div t-else="" t-attf-class="ac-drawer-item {{ c.id === state.conversationId ? 'active' : '' }}">
                            <span class="ac-drawer-title" t-on-click="() => this.openConversation(c.id)"
                                  t-esc="this.conversationTitle(c)"/>
                            <span class="ac-drawer-item-actions">
                                <button class="ac-icon-btn" title="Rename"
                                        t-on-click.stop="() => this.askRename(c)">
                                    <i class="fa fa-pencil"/>
                                </button>
                                <button class="ac-icon-btn" title="Remove"
                                        t-on-click.stop="() => this.askDelete(c)">
                                    <i class="fa fa-trash-o"/>
                                </button>
                            </span>
                        </div>
                    </t>

                    <!-- Cerrar sesion de la cuenta Aski. Solo a quien le
                         corresponde: en per_user cada quien la suya, en los
                         modos compartidos solo el admin (canConnect). -->
                    <div t-if="state.connected and state.canConnect" class="ac-drawer-foot">
                        <!-- CON QUE cuenta se esta hablando. En modo "por
                             usuario" cada quien conecta la suya y, sin esto, no
                             habia forma de saber cual quedo conectada aqui. -->
                        <div t-if="state.email" class="ac-drawer-account">
                            <i class="fa fa-user-circle-o"/> <t t-esc="state.email"/>
                        </div>
                        <button t-if="!state.confirmDisconnect" class="ac-drawer-disconnect"
                                t-on-click="askDisconnect">
                            <i class="fa fa-sign-out"/> Disconnect my Aski account
                        </button>
                        <div t-else="" class="ac-confirm">
                            <div class="ac-confirm-txt">Disconnect this Aski account? You can reconnect anytime with your token.</div>
                            <div class="ac-confirm-actions">
                                <button class="ac-confirm-cancel" t-on-click="cancelDisconnect">Cancel</button>
                                <button class="ac-confirm-ok" t-on-click="doDisconnect"
                                        t-att-disabled="state.disconnecting">
                                    <i t-if="state.disconnecting" class="fa fa-circle-o-notch fa-spin"/>
                                    Disconnect
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </t>


            <!-- ==========================================================
                 Grafico. En una VENTANA y no dentro de la burbuja, por lo
                 mismo que en la app: la tabla se queda siempre visible —es
                 lo auditable— y el mensaje no cambia de tamano al abrirlo.
                 Sin librerias: SVG a mano. Meter una dependencia entera
                 para tres formas no se justifica.
                 ========================================================== -->
            <t t-if="chartAbierto">
                <div class="ac-win-wrap">
                    <div class="ac-win-scrim" t-on-click="closeChart"/>
                <div class="ac-win ac-win-chart" role="dialog" aria-modal="true">
                    <div class="ac-win-head">
                        <span class="ac-win-title">Chart</span>
                        <button class="ac-icon-btn" title="Close" t-on-click="closeChart">
                            <i class="fa fa-times"/>
                        </button>
                    </div>
                    <div class="ac-win-body">
                        <t t-foreach="chartAbierto.series" t-as="s" t-key="s.currency + '-' + s_index">
                            <section class="ac-chart-serie">
                                <!-- El encabezado de moneda SOLO con varias: con
                                     una sola seria ruido, y el simbolo ya va en
                                     cada cifra. Jamas se comparten ejes entre
                                     monedas. -->
                                <h4 t-if="chartAbierto.series.length > 1 and s.currency"
                                    class="ac-chart-cur" t-esc="s.currency"/>

                                <!-- Barras -->
                                <div t-if="chartAbierto.kind === 'bar'" class="ac-chart-bars">
                                    <t t-foreach="barras(s, chartAbierto)" t-as="f" t-key="f.label + '-' + f_index">
                                        <div t-attf-class="ac-bar-row {{ f.otros ? 'otros' : '' }}">
                                            <span class="ac-bar-lbl" t-att-title="f.label" t-esc="f.label"/>
                                            <span class="ac-bar-track">
                                                <span t-if="!f.otros" class="ac-bar-fill"
                                                      t-attf-style="width: {{ f.pct }}%"/>
                                            </span>
                                            <span class="ac-bar-val" t-esc="f.valor"/>
                                        </div>
                                    </t>
                                </div>

                                <!-- Linea -->
                                <t t-if="chartAbierto.kind === 'line'">
                                    <t t-set="L" t-value="linea(s, chartAbierto)"/>
                                    <div class="ac-chart-line">
                                        <div class="ac-line-axis">
                                            <span t-esc="L.arriba"/>
                                            <span t-esc="L.abajo"/>
                                        </div>
                                        <svg t-attf-viewBox="0 0 {{ L.W }} {{ L.H }}"
                                             preserveAspectRatio="none" class="ac-line-svg" role="img">
                                            <t t-foreach="L.guias" t-as="g" t-key="g_index">
                                                <line x1="0" t-att-x2="L.W" t-att-y1="g" t-att-y2="g"
                                                      class="ac-line-grid"/>
                                            </t>
                                            <!-- ⛔ SIN puntos en los extremos: el
                                                 lienzo se estira en horizontal y eso
                                                 convierte un circulo en una elipse
                                                 aplastada que parece un fallo de
                                                 dibujo. El trazo se salva con
                                                 vector-effect, un circle no. -->
                                            <path t-att-d="L.d" class="ac-line-path"/>
                                        </svg>
                                        <div class="ac-line-lbls">
                                            <span t-esc="L.primero"/>
                                            <span t-esc="L.ultimo"/>
                                        </div>
                                    </div>
                                </t>

                                <!-- Dona -->
                                <t t-if="chartAbierto.kind === 'donut'">
                                    <t t-set="D" t-value="dona(s)"/>
                                    <div t-if="D" class="ac-chart-donut">
                                        <svg viewBox="0 0 180 180" class="ac-donut-svg" role="img">
                                            <g transform="translate(90,90) rotate(-90)">
                                                <t t-foreach="D.trozos" t-as="z" t-key="z_index">
                                                    <circle t-att-r="D.R" fill="none" t-att-stroke-width="D.G"
                                                            t-attf-class="ac-slice {{ z.clase }}"
                                                            t-att-stroke-dasharray="z.dash"
                                                            t-att-stroke-dashoffset="z.offset"/>
                                                </t>
                                            </g>
                                        </svg>
                                        <ul class="ac-donut-legend">
                                            <t t-foreach="D.trozos" t-as="z" t-key="z_index">
                                                <li>
                                                    <i t-attf-class="ac-dot {{ z.clase }}"/>
                                                    <span class="ac-leg-lbl" t-att-title="z.label" t-esc="z.label"/>
                                                    <span class="ac-leg-pct"><t t-esc="z.pct"/>%</span>
                                                </li>
                                            </t>
                                        </ul>
                                    </div>
                                </t>

                                <p class="ac-chart-foot" t-esc="pieGrafico(s, chartAbierto)"/>
                            </section>
                        </t>
                    </div>
                </div>
                </div>
            </t>

            <!-- ==========================================================
                 Compartir enlace. Solo CREA: administrar los enlaces de la
                 cuenta (verlos, revocarlos) no se hace desde el Odoo de un
                 cliente, y el backend tampoco lo acepta con token personal.
                 ========================================================== -->
            <t t-if="state.shareFor">
                <div class="ac-modal-wrap">
                    <div class="ac-modal-scrim" t-on-click="closeShare"/>
                    <div class="ac-modal" role="dialog" aria-modal="true">
                        <span class="ac-modal-badge"><i class="fa fa-link"/></span>
                        <t t-if="!state.shareUrl">
                            <h3 class="ac-modal-title">Share link</h3>
                            <p class="ac-modal-sub">Anyone with the link can read this answer. It expires on its own.</p>
                            <div class="ac-modal-body">
                                <span class="ac-modal-label">How long it lasts</span>
                                <div class="ac-modal-chips">
                                    <button t-foreach="[7, 30]" t-as="d" t-key="d"
                                            t-attf-class="ac-modal-chip {{ state.shareDays === d ? 'on' : '' }}"
                                            t-on-click="() => this.setShareDays(d)">
<t t-esc="plazoLabel(d)"/>
                                    </button>
                                </div>
                            </div>
                            <div class="ac-modal-acts">
                                <button class="ac-btn ghost" t-on-click="closeShare"
                                        t-att-disabled="state.shareBusy">Cancel</button>
                                <button class="ac-btn primary" t-on-click="doShare"
                                        t-att-disabled="state.shareBusy">
                                    <i t-if="state.shareBusy" class="fa fa-circle-o-notch fa-spin"/>
                                    Create link
                                </button>
                            </div>
                        </t>
                        <t t-else="">
                            <h3 class="ac-modal-title">Link ready</h3>
                            <div class="ac-modal-body">
                                <!-- La direccion se queda A LA VISTA y seleccionable:
                                     hay que copiarla, asi que un aviso que se va solo
                                     obligaria a ir a buscarla justo despues de
                                     crearla. -->
                                <div class="ac-modal-url">
                                    <input type="text" readonly="readonly" t-att-value="state.shareUrl"/>
                                </div>
                                <!-- El vencimiento que VUELVE del backend, no el que
                                     se pidio: el plan puede recortarlo en silencio. -->
                                <p t-if="state.shareExpires" class="ac-modal-hint">
                                    Expires: <t t-esc="caducidadFmt"/>
                                </p>
                            </div>
                            <div class="ac-modal-acts">
                                <button class="ac-btn ghost" t-on-click="copyShare">
                                    <i class="fa fa-clone"/> Copy
                                </button>
                                <button class="ac-btn primary" t-on-click="closeShare">Done</button>
                            </div>
                        </t>
                    </div>
                </div>
            </t>

            <!-- ==========================================================
                 Los registros detras de la cifra. El backend RE-EJECUTA la
                 consulta con los permisos del usuario, asi que puede
                 declinar con un motivo legible: eso no es un error, es la
                 explicacion, y se ensena tal cual.
                 Ventaja de estar DENTRO de Odoo: la fila abre el registro
                 de verdad, en vez de sacar al usuario a otra aplicacion.
                 ========================================================== -->
            <t t-if="state.recordsFor">
                <div class="ac-modal-wrap">
                    <div class="ac-modal-scrim" t-on-click="closeRecords"/>
                    <div class="ac-modal tall" role="dialog" aria-modal="true">
                        <span class="ac-modal-badge"><i class="fa fa-table"/></span>
                        <h3 class="ac-modal-title">
                            <t t-if="state.records and state.records.label" t-esc="state.records.label"/>
                            <t t-else="">Records</t>
                        </h3>
                        <div class="ac-modal-body">
                            <div t-if="state.recordsBusy" class="ac-loading">
                                <i class="fa fa-circle-o-notch fa-spin"/> <span>Loading…</span>
                            </div>
                            <t t-elif="state.records">
                                <p t-if="state.records.unavailable" class="ac-modal-empty"
                                   t-esc="state.records.unavailable"/>
                                <p t-elif="!(state.records.rows or []).length" class="ac-modal-empty">
                                    No records to show for this answer.
                                </p>
                                <t t-else="">
                                    <p class="ac-modal-count" t-if="state.records.total"
                                       t-esc="conteoRegistros"/>
                                    <ul class="ac-recs">
                                        <t t-foreach="state.records.rows or []" t-as="f" t-key="f.id">
                                            <li class="ac-rec" t-on-click="() => this.openRecord(f)">
                                                <span class="ac-rec-t" t-esc="f.title"/>
                                                <span t-if="f.subtitle" class="ac-rec-s" t-esc="f.subtitle"/>
                                            </li>
                                        </t>
                                    </ul>
                                </t>
                            </t>
                        </div>
                        <div class="ac-modal-acts">
                            <button class="ac-btn ghost" t-on-click="closeRecords">Close</button>
                        </div>
                    </div>
                </div>
            </t>

            <!-- ==========================================================
                 Enviar por correo. Sale con el reply-to del usuario: quien
                 lo recibe ve de quien viene y le contesta a EL.
                 ========================================================== -->
            <t t-if="state.emailFor">
                <div class="ac-modal-wrap">
                    <div class="ac-modal-scrim" t-on-click="closeEmail"/>
                    <div class="ac-modal" role="dialog" aria-modal="true">
                        <span class="ac-modal-badge"><i class="fa fa-envelope-o"/></span>
                        <h3 class="ac-modal-title">Send by email</h3>
                        <p class="ac-modal-sub">It goes out with your address as reply-to, so whoever receives it can answer you.</p>
                        <div class="ac-modal-body">
                            <span class="ac-modal-label">To (separate with commas)</span>
                            <input class="ac-modal-field" type="text" t-att-value="state.emailTo"
                                   placeholder="name@company.com" t-on-input="onEmailInput"/>
                            <button t-attf-class="ac-modal-check {{ state.emailAttach ? 'on' : '' }}"
                                    t-on-click="toggleEmailAttach">
                                <i t-attf-class="fa {{ state.emailAttach ? 'fa-check-square-o' : 'fa-square-o' }}"/>
                                Attach the spreadsheet
                            </button>
                        </div>
                        <div class="ac-modal-acts">
                            <button class="ac-btn ghost" t-on-click="closeEmail"
                                    t-att-disabled="state.emailBusy">Cancel</button>
                            <button class="ac-btn primary" t-on-click="doEmail"
                                    t-att-disabled="state.emailBusy">
                                <i t-if="state.emailBusy" class="fa fa-circle-o-notch fa-spin"/>
                                Send
                            </button>
                        </div>
                    </div>
                </div>
            </t>

            <!-- loading-state -->
            <div t-if="state.loading" class="ac-loading">
                <i class="fa fa-circle-o-notch fa-spin"/> <span>Loading…</span>
            </div>

            <!-- error-state: el estado NO se pudo leer (backend caido, sin red,
                 RPC roto). Va ANTES que "no conectado" a proposito: son cosas
                 distintas y antes se pintaban igual, asi que a quien ya tenia su
                 cuenta conectada se le pedia conectarla otra vez. -->
            <div t-elif="state.loadError" class="ac-empty">
                <span class="ac-mark ac-mark--lg"><t t-call="aski_connector.AskiMark"/></span>
                <div class="ac-empty-title">Aski isn't responding right now</div>
                <div class="ac-empty-sub" t-esc="state.loadError"/>
                <button class="ac-btn-primary" t-on-click="retryLoad">
                    <i class="fa fa-refresh"/> Try again
                </button>
            </div>

            <!-- empty-state: usuario fuera del grupo "Use the Aski chat" -->
            <div t-elif="!state.allowed" class="ac-empty">
                <span class="ac-mark ac-mark--lg"><t t-call="aski_connector.AskiMark"/></span>
                <div class="ac-empty-title">Aski chat isn't enabled for your user</div>
                <div class="ac-empty-sub">Ask an administrator to add you to the "Use the Aski chat" group to start asking your Odoo in plain language.</div>
            </div>

            <!-- empty-state: cuenta Aski no conectada -->
            <div t-elif="!state.connected" class="ac-empty">
                <span class="ac-mark ac-mark--lg"><t t-call="aski_connector.AskiMark"/></span>
                <t t-if="state.canConnect">
                    <div class="ac-empty-title">Connect Aski to start chatting</div>
                    <div class="ac-empty-sub">
                        Ask your Odoo in plain language, right here — sales, receivables,
                        top products and more.
                    </div>
                    <button class="ac-btn-primary" t-on-click="openConnect">
                        Connect my Aski account
                    </button>
                </t>
                <t t-else="">
                    <div class="ac-empty-title">Aski isn't set up yet</div>
                    <div class="ac-empty-sub">
                        Ask an administrator to connect Aski for your team.
                    </div>
                </t>
            </div>

            <t t-else="">
                <div class="ac-messages" t-ref="messages">
                    <!-- welcome hero (nueva conversacion, sin mensajes) -->
                    <div t-if="!state.messages.length" class="ac-welcome">
                        <span class="ac-mark ac-mark--lg"><t t-call="aski_connector.AskiMark"/></span>
                        <div class="ac-welcome-title">Hi, I'm Aski</div>
                        <div class="ac-welcome-sub">Ask about your business in plain language — sales, receivables, top customers and more. Read-only &amp; safe.</div>
                        <!-- Las sugerencias vienen del getter `samples` (JS, con _t()):
                             la etiqueta y el texto que se ENVIA son el MISMO string
                             traducido. Antes el t-on-click llevaba el literal ingles
                             hardcodeado -> se veia en espanol pero se mandaba en ingles. -->
                        <div class="ac-samples">
                            <button t-foreach="samples" t-as="s" t-key="s.text"
                                    class="ac-sample" t-on-click="() => this.useSample(s.text)">
                                <i t-attf-class="fa {{ s.icon }}"/> <t t-esc="s.text"/>
                            </button>
                        </div>
                    </div>
                    <t t-foreach="state.messages" t-as="m" t-key="m.id">
                        <div t-if="m.role === 'user'" class="ac-bubble ac-bubble-user">
                            <span t-esc="m.text"/>
                            <!-- Esta pregunta se hizo en analisis profundo. Va en
                                 la PREGUNTA y no en la respuesta porque es ahi
                                 donde lo guarda el backend (is_agent) y donde lo
                                 pintan la app y la web: al recargar el hilo, el
                                 distintivo sigue en su sitio. -->
                            <span t-if="m.deep" class="ac-deep-chip">
                                <i class="fa fa-flask"/> Deep
                            </span>
                            <!-- La hora va en las DOS burbujas, como en la app y
                                 en la web. -->
                            <div class="ac-meta">
                                <span class="ac-time" t-esc="bubbleTime(m.createdAt)"/>
                            </div>
                        </div>
                        <div t-elif="m.role === 'assistant'" class="ac-bubble ac-bubble-bot">
                            <t t-set="graf" t-value="chartDe(m)"/>
                            <button t-if="graf" class="ac-chart-open"
                                    t-on-click="() => this.openChart(m)">
                                <i class="fa fa-bar-chart"/> View chart
                                <!-- "Convertido" NO es un detalle tecnico: dos
                                     respuestas con el mismo simbolo significan
                                     cosas distintas segun la base, y el usuario
                                     no tiene como saberlo si no se le dice. -->
                                <span t-if="graf.currency_mode === 'convertido'"
                                      class="ac-chart-conv"> · <t t-esc="etiquetaConvertido"/></span>
                            </button>
                            <div class="md" t-out="renderMd(m.text)"/>
                            <!-- La fila se pinta SIEMPRE; lo condicional es el chip
                                 de creditos. Cuando el t-if colgaba de la fila, una
                                 respuesta sin cobro (historicos, turnos sin cargo) se
                                 quedaba sin hora, sin detalle, sin PDF y sin pulgares.
                                 La web ya lo tenia asi. -->
                            <div class="ac-meta">
                                <span class="ac-time" t-esc="bubbleTime(m.createdAt)"/>
                                <!-- Que esta respuesta salio del analisis profundo:
                                     cuesta mas creditos y conviene que se vea. -->
                                <span t-if="m.deep" class="ac-deep-chip"><i class="fa fa-flask"/> Deep</span>
                                <span t-if="m.credits !== null" class="ac-credits-chip"><i class="fa fa-bolt"/> <t t-esc="m.credits"/> credits</span>
                                <!-- Pulgares PULSABLES aqui mismo. Antes el control
                                     vivia dentro de "Details": nadie abre detalles
                                     cuando una respuesta le sirve, y menos cuando NO
                                     le sirve — reformula y sigue. Medido en produccion:
                                     2 dislikes y 0 likes en 10.389 turnos, con quejas
                                     escritas en el chat que nunca llegaron al panel.
                                     Sin backendId no hay a quien mandarle el voto (la
                                     burbuja recien enviada aun no se ha reconciliado). -->
                                <button t-if="m.backendId" title="Helpful answer"
                                        t-attf-class="ac-fb-quick {{ m.feedback === 'like' ? 'on' : '' }}"
                                        t-att-aria-pressed="m.feedback === 'like' ? 'true' : 'false'"
                                        t-on-click="() => this.setFeedback(m, 'like')">
                                    <i class="fa fa-thumbs-o-up"/>
                                </button>
                                <button t-if="m.backendId" title="Unhelpful answer"
                                        t-attf-class="ac-fb-quick {{ m.feedback === 'dislike' ? 'on' : '' }}"
                                        t-att-aria-pressed="m.feedback === 'dislike' ? 'true' : 'false'"
                                        t-on-click="() => this.setFeedback(m, 'dislike')">
                                    <i class="fa fa-thumbs-o-down"/>
                                </button>
                                <button t-if="m.backendId" class="ac-detail-btn" title="Details"
                                        t-on-click="() => this.toggleDetail(m)">
                                    <i class="fa fa-info-circle"/>
                                </button>
                            </div>
                        </div>
                        <div t-else="" class="ac-bubble ac-bubble-error">
                            <!-- Mismo renderizado que la burbuja normal: los
                                 mensajes de error del backend TAMBIEN vienen en
                                 markdown, y con t-esc el usuario leia los
                                 asteriscos crudos ("**Tu ERP no respondio.**") y
                                 perdia los saltos de parrafo. -->
                            <!-- El icono va en su PROPIO nodo y el markdown en un
                                 div hermano: mdToHtml emite bloques (<p>, <ul>)
                                 y meterlos en un <span> es HTML invalido, el
                                 navegador los reubica y rompe la burbuja. -->
                            <div class="ac-error-body">
                                <i class="fa fa-exclamation-triangle"/>
                                <div class="md" t-out="renderMd(m.text)"/>
                            </div>
                            <div class="ac-error-actions">
                                <!-- Se le pasa el MENSAJE, no solo el texto: al
                                     reintentar hay que retirar esta burbuja, o
                                     los errores se van apilando en el hilo. -->
                                <button class="ac-btn-link" t-on-click="() => this.retry(m)">
                                    Retry
                                </button>
                                <button t-if="m.sinCreditos and !state.partnerManaged"
                                        class="ac-btn-link" t-on-click="openBilling">
                                    Top up credits
                                </button>
                            </div>
                        </div>
                    </t>
                    <!-- "Aski esta pensando" -->
                    <div t-if="state.sending" class="ac-bubble ac-bubble-bot ac-thinking">
                        <span class="ac-typing"><i/><i/><i/></span>
                        <!-- El tiempo REAL transcurrido (no fases inventadas: el
                             backend no reporta progreso por esta via). Aparece a
                             los 3 s para no parpadear en las respuestas rapidas;
                             en analisis profundo se avisa de que va para largo,
                             que puede pasar del minuto. -->
                        <span t-if="state.elapsed >= 3" class="ac-thinking-note">
                            <t t-if="state.sendingDeep">Digging deeper — this one takes a while.</t>
                            <t t-else="">Working on it…</t>
                            <span class="ac-thinking-secs"><t t-esc="state.elapsed"/>s</span>
                        </span>
                    </div>
                </div>

                <div class="ac-composer">
                    <!-- El agente avisa de que la consulta es pesada y espera el
                         visto bueno, igual que en la app. -->
                    <div t-if="state.pendingHeavy" class="ac-heavy">
                        <div class="ac-heavy-txt">This one needs a heavier analysis. Run it anyway?</div>
                        <div class="ac-heavy-actions">
                            <button class="ac-confirm-cancel" t-on-click="cancelHeavy">Not now</button>
                            <button class="ac-confirm-ok" t-on-click="confirmHeavy"
                                    t-att-disabled="state.sending">Run it</button>
                        </div>
                    </div>

                    <!-- Analisis profundo: solo se ofrece si el plan lo incluye
                         (agentEnabled lo dice el backend). Ofrecerlo siempre era
                         prometer algo que acaba en un 403. -->
                    <div t-if="state.agentEnabled or state.conversationId" class="ac-composer-tools">
                        <button t-if="state.conversationId" class="ac-fresh"
                                t-on-click="clearContext" t-att-disabled="state.clearing || state.sending"
                                title="Forget what we talked about, without deleting the thread">
                            <i t-attf-class="fa {{ state.clearing ? 'fa-circle-o-notch fa-spin' : 'fa-refresh' }}"/>
                            Start fresh
                        </button>
                        <span t-else="" class="ac-tools-gap"/>
                        <button t-if="state.agentEnabled"
                                t-attf-class="ac-deep-toggle {{ state.deepMode ? 'on' : '' }}"
                                t-on-click="toggleDeepMode" t-att-disabled="state.sending"
                                title="Deep analysis: slower, but digs through more data">
                            <i class="fa fa-flask"/> Deep analysis
                        </button>
                    </div>

                    <div class="ac-composer-inner">
                        <button t-if="state.conversationId" class="ac-export" title="Export last answer to PDF"
                                t-on-click="exportPdf" t-att-disabled="state.exporting">
                            <i t-attf-class="fa {{ state.exporting ? 'fa-circle-o-notch fa-spin' : 'fa-file-pdf-o' }}"/>
                        </button>
                        <!-- textarea y NO input: el handler distingue Shift+Enter
                             para partir la linea, y en un <input> eso no puede
                             pasar. Sin `value` atado al estado — ver composerRef.
                             Tampoco se DESHABILITA mientras Aski responde: se
                             puede ir escribiendo la siguiente pregunta, solo el
                             boton de enviar espera. -->
                        <textarea t-ref="composer" rows="1" t-att-maxlength="MAX_PROMPT"
                                  placeholder="Ask Aski anything about your Odoo…"
                                  t-on-input="onInput" t-on-keydown="onKeydown"/>
                        <button class="ac-send" t-on-click="() => this.send()"
                                t-att-disabled="state.sending || !state.input.trim()">
                            <i t-attf-class="fa {{ state.sending ? 'fa-circle-o-notch fa-spin' : 'fa-paper-plane' }}"/>
                        </button>
                    </div>
                </div>
            </t>

            </t>

            <!-- Detalle de UNA respuesta. Va ENCIMA del chat (scrim + hoja), como
                 la hoja de Android y la de la web. Colgado bajo la burbuja se abria
                 DEBAJO del contenido: con una respuesta larga (una tabla) no se veia
                 y habia que adivinar que algo se habia desplegado.
                 Se monta al final de .aski-chat, que ya es `position: relative` con
                 `overflow: hidden`, asi queda contenido igual en pantalla completa
                 que en la burbuja estrecha del systray. -->
            <div t-if="detailMsg" class="ac-sheet-wrap">
                <div class="ac-scrim" t-on-click="closeDetail"/>
                <div class="ac-sheet" role="dialog" aria-modal="true">
                    <t t-set="m" t-value="detailMsg"/>
                    <div class="ac-sheet-grip"/>
                    <div class="ac-sheet-head">
                        <span class="ac-sheet-title">Response details</span>
                        <button class="ac-sheet-close" title="Close" t-on-click="closeDetail">
                            <i class="fa fa-times"/>
                        </button>
                    </div>
                        <div class="ac-detail">
                            <div class="ac-detail-stats">
                                <div class="ac-stat">
                                    <i class="fa fa-bolt"/>
                                    <div><div class="ac-stat-v" t-esc="m.credits ?? '—'"/><div class="ac-stat-k">credits</div></div>
                                </div>
                                <div t-if="m.rows !== null" class="ac-stat">
                                    <i class="fa fa-table"/>
                                    <div><div class="ac-stat-v" t-esc="m.rows"/><div class="ac-stat-k">rows</div></div>
                                </div>
                            </div>
                            <!-- Aqui vivia un segundo "Helpful? 👍👎", que se quito
                                 al subir los pulgares a la fila de la burbuja: este
                                 panel es INLINE (en la app y en la web el detalle es
                                 una hoja que TAPA el chat, y por eso alli si
                                 conviven), asi que los dos controles quedaban a la
                                 vista en la misma tarjeta, a 40 px uno del otro, y
                                 parecian un descuido. Lo que SI vive aqui es el POR
                                 QUE, lo unico que convierte un pulgar en algo
                                 accionable: la unica queja real de un cliente llego
                                 ESCRITA en el chat, nunca por el pulgar, asi que el
                                 panel de calidad no la veia. Solo se pide tras un 👎.
                                 La etiqueta ENVUELVE al textarea en vez de usar
                                 for/id: el widget puede estar montado dos veces a
                                 la vez (pantalla completa + burbuja del systray) y
                                 dos ids iguales dejarian la etiqueta ambigua.
                                 El contenido se pinta desde `fbInitial`, que NO
                                 cambia mientras el panel esta abierto: enlazarlo a
                                 `fbComment` haria que OWL reescribiera el texto en
                                 cada pulsacion y el cursor saltaria al final al
                                 corregir algo en mitad de la frase. -->
                            <!-- El voto TAMBIEN aqui, como en la hoja de Android y la
                                 de la web. No es un duplicado ocioso: la hoja TAPA el
                                 chat, asi que con ella abierta los pulgares pequenos de
                                 la burbuja quedan detras del scrim y no se pueden
                                 pulsar; sin estos habria que cerrar para cambiar el voto. -->
                            <div class="ac-detail-fb">
                                <span>Helpful?</span>
                                <button t-attf-class="ac-fb-btn {{ m.feedback === 'like' ? 'on' : '' }}"
                                        title="Helpful answer"
                                        t-att-aria-pressed="m.feedback === 'like' ? 'true' : 'false'"
                                        t-on-click="() => this.setFeedback(m, 'like')">
                                    <i class="fa fa-thumbs-o-up"/>
                                </button>
                                <button t-attf-class="ac-fb-btn {{ m.feedback === 'dislike' ? 'on' : '' }}"
                                        title="Unhelpful answer"
                                        t-att-aria-pressed="m.feedback === 'dislike' ? 'true' : 'false'"
                                        t-on-click="() => this.setFeedback(m, 'dislike')">
                                    <i class="fa fa-thumbs-o-down"/>
                                </button>
                            </div>
                            <label t-if="m.feedback === 'dislike'" class="ac-fb-why">
                                <span class="ac-fb-why-label">What went wrong? (optional)</span>
                                <textarea class="ac-fb-why-input" rows="3" maxlength="500"
                                          placeholder="E.g.: the total doesn't match what I see in my ERP"
                                          t-on-input="onFbCommentInput"
                                          t-esc="state.fbInitial"/>
                            </label>
                            <div t-if="m.feedback === 'dislike'" class="ac-fb-why-actions">
                                <button class="ac-fb-send" t-on-click="() => this.sendFeedbackComment(m)"
                                        t-att-disabled="state.fbSending || !state.fbComment.trim()">
                                    <t t-if="state.fbSending">Sending…</t>
                                    <t t-else="">Send</t>
                                </button>
                                <span t-if="state.fbSent" class="ac-fb-note ac-fb-ok">
                                    <i class="fa fa-check"/> Thanks. Now we know what to fix.
                                </span>
                                <span t-if="state.fbError" class="ac-fb-note ac-fb-bad">
                                    <i class="fa fa-exclamation-circle"/> Couldn't send your note. Please try again.
                                </span>
                            </div>
                            <div class="ac-acts">
                                <button t-if="m.backendId" class="ac-act"
                                        t-on-click="() => this.openRecords(m)"
                                        t-att-disabled="state.recordsBusy">
                                    <i class="fa fa-table"/> <span>See the records behind this</span>
                                </button>
                                <button class="ac-act" t-on-click="() => this.copyText(m)">
                                    <i class="fa fa-clone"/> <span>Copy text</span>
                                </button>
                                <button t-if="m.backendId" class="ac-act"
                                        t-on-click="() => this.openShare(m)">
                                    <i class="fa fa-link"/> <span>Share link</span>
                                </button>
                                <button class="ac-act" t-on-click="() => this.exportMessageDetail(m)"
                                        t-att-disabled="state.exporting">
                                    <i t-attf-class="fa {{ state.exporting ? 'fa-circle-o-notch fa-spin' : 'fa-file-pdf-o' }}"/>
                                    <span>Export this answer to PDF</span>
                                </button>
                                <button t-if="m.backendId" class="ac-act"
                                        t-on-click="() => this.exportXlsx(m)"
                                        t-att-disabled="state.xlsxBusy">
                                    <i t-attf-class="fa {{ state.xlsxBusy ? 'fa-circle-o-notch fa-spin' : 'fa-file-excel-o' }}"/>
                                    <span>Export to Excel</span>
                                </button>
                                <button t-if="m.backendId" class="ac-act"
                                        t-on-click="() => this.openEmail(m)">
                                    <i class="fa fa-envelope-o"/> <span>Send by email</span>
                                </button>
                            </div>
                        </div>
                </div>
            </div>
        </div>
    </t>
</templates>
