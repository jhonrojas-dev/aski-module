#: model:ir.model.fields,field_description:aski_connector.field_aski_account_link__seats_summary_html
msgid "Team seats"
msgstr "Teamstoelen"

#. module: aski_connector
#. odoo-python
#: code:addons/aski_connector/models/aski_account_link.py:0
