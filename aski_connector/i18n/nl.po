msgstr "Welk abonnement wil je?"

#. module: aski_connector
#. odoo-javascript
#: code:addons/aski_connector/static/src/chat/aski_chat.xml:0
msgid "cr"
msgstr "cr"

#. module: aski_connector
#. odoo-javascript
#: code:addons/aski_connector/static/src/chat/aski_chat.xml:0
msgid "· requested"
msgstr "· aangevraagd"

#. module: aski_connector
#. odoo-javascript
#: code:addons/aski_connector/static/src/chat/aski_chat.xml:0
msgid ""
"Everything is listed. What your connection does not support is\n"
"                            marked, so you can see what you are missing."
msgstr ""
"Alles staat erbij. Wat je verbinding niet ondersteunt is gemarkeerd, zo zie "
"je wat je mist."

#. module: aski_connector
#. odoo-javascript
#: code:addons/aski_connector/static/src/chat/aski_chat.xml:0
