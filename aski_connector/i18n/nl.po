#. odoo-javascript
#: code:addons/aski_connector/static/src/chat/aski_chat.js:0
msgid "paused: your plan no longer includes it"
msgstr "gepauzeerd: je abonnement bevat dit niet meer"

#. module: aski_connector
#. odoo-javascript
#: code:addons/aski_connector/static/src/chat/aski_chat.js:0
