msgstr "Cijfers die ik kan bewaken"

#. module: aski_connector
#. odoo-javascript
#: code:addons/aski_connector/static/src/chat/aski_chat.xml:0
msgid "Not in your connection"
msgstr "Niet in je verbinding"

#. module: aski_connector
#. odoo-javascript
#: code:addons/aski_connector/static/src/chat/aski_chat.xml:0
msgid ""
"Nothing runs on its own: I propose it and you confirm it, with your own "
"permissions."
msgstr ""
"Niets draait vanzelf: ik stel het voor en jij bevestigt het, met je eigen "
"rechten."

#. module: aski_connector
#. odoo-javascript
#: code:addons/aski_connector/static/src/chat/aski_chat.xml:0
