#. odoo-javascript
#: code:addons/aski_connector/static/src/chat/aski_chat.xml:0
msgid "Not in your connection"
msgstr "Pas dans votre connexion"

#. module: aski_connector
#. odoo-javascript
#: code:addons/aski_connector/static/src/chat/aski_chat.xml:0
